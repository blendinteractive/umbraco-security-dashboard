<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PackageId>Umbraco.SecurityDashboard</PackageId>
    <Version>1.0.0</Version>
    <Authors>Umbraco Security Dashboard Contributors</Authors>
    <Description>Adds a Security Vulnerability Dashboard to the Umbraco Backoffice Settings section, scanning installed Umbraco packages against the GitHub Advisory Database.</Description>
    <PackageTags>umbraco;security;vulnerability;dashboard</PackageTags>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Umbraco.Cms" Version="17.*" />
    <PackageReference Include="NuGet.Versioning" Version="6.*" />
    <!-- Swashbuckle.AspNetCore is provided transitively by Umbraco.Cms 17.x (10.x) -->
  </ItemGroup>

  <!-- Include compiled frontend assets in the NuGet package -->
  <ItemGroup>
    <Content Include="App_Plugins\**" Pack="true" PackagePath="content\App_Plugins\" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
