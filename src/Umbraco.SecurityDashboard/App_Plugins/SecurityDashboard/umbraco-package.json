{
  "$schema": "../../umbraco-package-schema.json",
  "name": "Umbraco.SecurityDashboard",
  "version": "1.0.0",
  "extensions": [
    {
      "type": "dashboard",
      "alias": "SecurityDashboard.Dashboard",
      "name": "Security Dashboard",
      "element": "/App_Plugins/SecurityDashboard/dist/security-dashboard.js",
      "weight": -1,
      "meta": {
        "label": "Security",
        "pathname": "security"
      },
      "conditions": [
        {
          "alias": "Umb.Condition.SectionAlias",
          "match": "Umb.Section.Settings"
        }
      ]
    }
  ]
}
